{
  "format": "quetzal.discrete_layout",
  "version": "0.4",
  "layout": {
    "components": { "access_points": [ { "entity": 1 } ] }
  },
  "cells": {
    "notation": "block",
    "extent": [5, 5],
    "origin": [0.0, 0.0, 0.0],
    "scale": 1.0,
    "rows": [
      "#<###",
      "#...#",
      "#.#.#",
      "#...#",
      "#####"
    ]
  },
  "entities": [
    { "id": 1, "type": "waypoint", "components": { "site": { "relation": "on", "wall": { "cell_position": [1, 3], "normal": [0, -1] } }, "relocator": { "type": "up", "target": "up", "order": 0, "entry": { "cell_position": [1, 3], "orientation": [0, -1] } } } }
  ]
}
