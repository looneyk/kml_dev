{
  "format": "quetzal.discrete_layout",
  "version": "0.6",
  "layout": {
    "components": { "access_points": [ { "entity": 3 } ], "unpopulated": true }
  },
  "cells": {
    "notation": "block",
    "extent": [6, 5],
    "origin": [0.0, 0.0, 0.0],
    "scale": 1.0,
    "rows": [
      "#<####",
      "#...##",
      "#...+#",
      "#...##",
      "######"
    ]
  },
  "entities": [
    { "id": 1, "type": "door" },
    { "id": 2, "type": "door_facing", "components": { "parent": { "entity": 1 }, "site": { "relation": "on", "wall": { "cell_position": [3, 2], "normal": [-1, 0] } } } },
    { "id": 3, "type": "staircase", "components": { "site": { "relation": "on", "wall": { "cell_position": [1, 3], "normal": [0, -1] } }, "access_point": { "type": "staircase", "target": "+1", "order": 0 } } }
  ]
}
