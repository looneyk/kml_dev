{
  "format": "quetzal.discrete_layout",
  "version": "0.5",
  "layout": {
    "components": { "access_points": [ { "entity": 1 } ], "unpopulated": true }
  },
  "cells": {
    "notation": "block",
    "extent": [8, 6],
    "origin": [0.0, 0.0, 0.0],
    "scale": 1.0,
    "rows": [
      "#<######",
      "#......#",
      "#.##...#",
      "#.#....#",
      "#......#",
      "########"
    ]
  },
  "entities": [
    { "id": 1, "type": "staircase", "components": { "site": { "relation": "on", "wall": { "cell_position": [1, 4], "normal": [0, -1] } }, "relocator": { "type": "staircase", "target": "+1", "order": 0, "placement": { "cell_position": [1, 4], "orientation": [0, -1] } } } }
  ]
}
