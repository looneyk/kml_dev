{
  "format": "quetzal.discrete_layout",
  "version": "0.4",
  "layout": {
    "components": { "access_points": [ { "entity": 4 } ] }
  },
  "cells": {
    "notation": "block",
    "extent": [5, 3],
    "origin": [0.0, 0.0, 0.0],
    "scale": 1.0,
    "rows": [
      "#<###",
      "#.+.#",
      "#####"
    ]
  },
  "entities": [
    { "id": 1, "type": "door" },
    { "id": 2, "type": "door_facing", "components": { "parent": { "entity": 1 }, "site": { "relation": "on", "wall": { "cell_position": [3, 1], "normal": [1, 0] } } } },
    { "id": 3, "type": "door_facing", "components": { "parent": { "entity": 1 }, "site": { "relation": "on", "wall": { "cell_position": [1, 1], "normal": [-1, 0] } } } },
    { "id": 4, "type": "waypoint", "components": { "site": { "relation": "on", "wall": { "cell_position": [1, 1], "normal": [0, -1] } }, "relocator": { "type": "up", "target": "up", "order": 0, "entry": { "cell_position": [1, 1], "orientation": [0, -1] } } } }
  ]
}
