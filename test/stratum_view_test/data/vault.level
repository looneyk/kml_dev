{
  "format": "quetzal.discrete_layout",
  "version": "0.4",
  "layout": {
    "components": { "access_points": [ { "entity": 1 } ] }
  },
  "cells": {
    "notation": "block",
    "extent": [8, 6],
    "origin": [0.0, 0.0, 0.0],
    "scale": 1.0,
    "rows": [
      "#<######",
      "#......#",
      "#.##...#",
      "#.#....#",
      "#......#",
      "########"
    ]
  },
  "entities": [
    { "id": 1, "type": "waypoint", "components": { "site": { "relation": "on", "wall": { "cell_position": [1, 4], "normal": [0, -1] } }, "relocator": { "target": "up" } } }
  ]
}
