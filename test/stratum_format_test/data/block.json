{
  "format": "quetzal.discrete_layout",
  "version": "0.4",
  "layout": {
    "components": { "name": "Two Rooms", "access_points": [ { "entity": 4 }, { "entity": 6 } ] }
  },
  "cells": {
    "notation": "block",
    "extent": [7, 5],
    "origin": [-3.5, -2.5, 0.0],
    "scale": 2.0,
    "rows": [
      "#######",
      "#..#..#",
      "#..+.>#",
      "#..#.<#",
      "#######"
    ]
  },
  "rooms": [
    { "cell_position": [1, 1], "barriers": [ { "cell_position": [2, 3] } ], "components": { "name": "the west room" } },
    { "perimeter": [[3, 2], [4, 2], [4, 1], [5, 1], [5, 3], [6, 3], [6, 4], [4, 4], [4, 3], [3, 3]], "components": { "style": { "name": "hall", "lit": true } } }
  ],
  "walls": [
    { "wall": { "cell_position": [1, 1], "normal": [0, 1] }, "components": { "moss": 0.5 } },
    { "wall": { "cell_position": [3, 2], "normal": [0, -1] } }
  ],
  "flats": [
    { "role": "floor",
      "cells": [
        { "cell_position": [5, 2], "height": -0.5 }
      ] },
    { "role": "ceiling", "height": 4.0, "components": { "style": "vaulted" },
      "rooms": [
        { "room": 1, "height": 6.0 }
      ] }
  ],
  "entities": [
    { "id": 1, "type": "door", "components": { "locked": true } },
    { "id": 2, "type": "door_facing", "components": { "parent": { "entity": 1 }, "site": { "relation": "on", "wall": { "cell_position": [2, 2], "normal": [-1, 0] }, "position": [0.5, 0.0] } } },
    { "id": 3, "type": "door_facing", "components": { "parent": { "entity": 1 }, "site": { "relation": "on", "wall": { "cell_position": [4, 2], "normal": [1, 0] }, "position": [0.5, 0.0] } } },
    { "id": 4, "type": "staircase", "components": { "site": { "relation": "on", "wall": { "cell_position": [4, 2], "normal": [-1, 0] } }, "relocator": { "type": "down", "target": "down", "order": 0, "entry": { "cell_position": [4, 2], "orientation": [-1, 0] } } } },
    { "id": 5, "type": "lamp", "components": { "site": { "relation": "on", "flat": "ceiling", "cell_position": [1, 1] }, "custom": { "anything": [1, 2, 3] } } },
    { "id": 6, "type": "waypoint", "components": { "site": { "relation": "on", "wall": { "cell_position": [4, 1], "normal": [-1, 0] } }, "relocator": { "type": "up", "target": "up", "order": 0, "entry": { "cell_position": [4, 1], "orientation": [-1, 0] } } } }
  ]
