  "attachments": [
    { "walls": [[2, 2, -1, 0], [4, 2, 1, 0]], "position": [0.5, 0.0], "entities": [ { "type": "door", "components": { "locked": true } } ] },
    { "flat": "ceiling", "cell": [1, 1], "entities": [ { "type": "lamp", "custom": { "anything": [1, 2, 3] } } ] },
    { "flat": "floor", "cell": [5, 2], "entities": [ { "type": "staircase", "components": { "relocator": { "target": "level_down" } } } ] },
    { "flat": "floor", "cell": [5, 1], "entities": [ { "type": "waypoint", "components": { "relocator": { "target": "level_up" } } } ] }
  ]
}
