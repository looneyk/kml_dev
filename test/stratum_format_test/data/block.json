{
  "format": "quetzal.discrete_layout",
  "version": "0.3",
  "layout": {
    "components": { "name": "Two Rooms", "entry": [[5, 2], [5, 1]] }
  },
  "cells": {
    "notation": "block",
    "extent": [7, 5],
    "origin": [-3.5, -2.5, 0.0],
    "scale": 2.0,
    "rows": [
      "#######",
      "#..#..#",
      "#..+.>#",
      "#..#.<#",
      "#######"
    ]
