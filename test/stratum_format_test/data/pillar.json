{
  "format": "quetzal.discrete_layout",
  "version": "0.3",
  "layout": {
    "components": { "entry": [[0, 0]] }
  },
  "cells": {
    "notation": "wall",
    "extent": [4, 3],
    "rows": [
      " - - - - ",
      "|. . . .|",
      "   -     ",
      "|.| |. .|",
      "   -     ",
      "|< . . .|",
      " - - - - "
    ]
  },
