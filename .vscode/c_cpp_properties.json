{
    "configurations": [
        {
            "name": "Win32",
            "includePath": [
                "${workspaceFolder}",
                "${workspaceFolder}/library",
                "${workspaceFolder}/library3/doctest",
                "${workspaceFolder}/library3/flecs/include",
                "${workspaceFolder}/library3/glfw/include",
                "${workspaceFolder}/library3/glm",
                "${workspaceFolder}/library3/json/include",
                "${workspaceFolder}/library3/stb",
                "${workspaceFolder}/library3/tinyobjloader",
                "${workspaceFolder}/library3/VulkanMemoryAllocator/include",
                "${workspaceFolder}/library3/KTX-Software/lib/include",
                "${env:VULKAN_SDK}/Include"
            ],
            "browse": {
                "path": [
                    "${workspaceFolder}/library"
                ],
                "limitSymbolsToIncludedHeaders": true,
                "databaseFilename": "${workspaceFolder}/.vscode/browse.vc.db"
            },
            "defines": [
                "UNICODE",
                "_UNICODE"
            ],
            "cStandard": "c17",
            "cppStandard": "c++26",
            "intelliSenseMode": "windows-msvc-x64"
        }
    ],
    "version": 4
}