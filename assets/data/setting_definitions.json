    { "key": "gameplay.difficulty.denizen_speed_multiplier", "type": "real", "default": "1", "scope": "game", "modifiable": true, "minimum": "0.25", "maximum": "4",
      "display_name": "Denizen speed", "description": "How fast denizens move", "category": "difficulty" },
    { "key": "gameplay.difficulty.detection_range_multiplier", "type": "real", "default": "1", "scope": "game", "modifiable": true, "minimum": "0.25", "maximum": "4",
