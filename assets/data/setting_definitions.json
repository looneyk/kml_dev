    { "key": "world.region_size.x", "type": "integer", "default": "1000", "scope": "game", "minimum": "1",
      "display_name": "Region size x", "description": "The size of a region in zones in the x direction", "category": "world" },
    { "key": "world.region_size.y", "type": "integer", "default": "1000", "scope": "game", "minimum": "1",
      "display_name": "Region size y", "description": "The size of a region in zones in the y direction", "category": "world" },
    { "key": "world.region_size.z", "type": "integer", "default": "1000", "scope": "game", "minimum": "1",
      "display_name": "Region size z", "description": "The size of a region in zones in the z direction", "category": "world" },
    { "key": "world.zone_size.x", "type": "integer", "default": "40", "scope": "game", "minimum": "1",
