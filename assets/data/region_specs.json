{
  "format": "quetzal.stratum_region_specs",
  "version": "0.1",
  "region_specs": {
    "surface": {
      "extent": { "arrangement": "ranges", "boxes": [ { "x": [0, 9], "y": [0, 9], "z": 0 } ] },
      "zone.name": "&region_name .. '_' .. x .. '_' .. y",
      "zone.parameters.algorithm": "surface1",
      "zone.parameters.stairs_down": "2-4",
      "zone.parameters.stairs_up": "0-0",
      "zone.parameters.stairs_down_region_spec": "dungeon"
    },
    "dungeon": {
      "extent": { "arrangement": "ranges", "boxes": [ { "x": 0, "y": 0, "z": [-100, -1] } ] },
      "zone.name": "&region_name .. '_' .. math.abs(z)"
    }
  }
}
