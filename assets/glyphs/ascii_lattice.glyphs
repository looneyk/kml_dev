glyphs 0.1

# The glyphs the wall format writes, so that a level rendered onto the lattice reproduces
# the file it was loaded from

# An actor stands on a place rather than being one, so it asks for what is under it. These
# come first to win the tie against a line asking for one state: a mover in an open doorway
# draws as the mover
floor actor '@'
door actor '@'

solid '#'
none ' '
floor ' '

door '/'
door open '\'

# ASCII has three glyphs for the sixteen joints the mask tells apart, so a wall is sixteen
# lines: the run passing through one way or the other, a junction where both axes reach it,
# and nothing where neither does
wall mask= ' '
wall mask=E '-'
wall mask=N '|'
wall mask=EN '+'
wall mask=W '-'
wall mask=EW '-'
wall mask=NW '+'
wall mask=ENW '+'
wall mask=S '|'
wall mask=ES '+'
wall mask=NS '|'
wall mask=ENS '+'
wall mask=WS '+'
wall mask=EWS '+'
wall mask=NWS '+'
wall mask=ENWS '+'
