{
  "permissions": {
    "allow": [
      "Bash(cmake*)",
      "Bash(MSBuild*)",
      "Bash(./bin/Debug/*)",
      "Bash(./model/*)",
      "Bash(ls*)",
      "Bash(cat*)",
      "Bash(head*)",
      "Bash(tail*)",
      "Bash(wc*)",
      "Bash(grep*)",
      "Bash(sed*)",
      "Bash(awk*)",
      "Bash(sort*)",
      "Bash(uniq*)",
      "Bash(diff*)",
      "Bash(find*)",
      "Bash(echo*)",
      "Bash(git status*)",
      "Bash(git log*)",
      "Bash(git diff*)",
      "Read(//tmp/**)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/check_wording.sh\"",
            "timeout": 30,
            "statusMessage": "Checking wording"
          }
        ]
      }
    ]
  }
}
